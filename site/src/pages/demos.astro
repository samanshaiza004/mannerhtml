---
import PortalFooter from "../components/PortalFooter.astro";
import PortalHeader from "../components/PortalHeader.astro";
import PortalPanel from "../components/PortalPanel.astro";
import "../styles/portal.css";

const base = import.meta.env.BASE_URL;
const library = `${base}dist/index.js`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Try MannerHTML tabs and form validation in live, keyboard-operable demos." />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>Live demos — MannerHTML</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="portal-shell">
      <PortalHeader />
      <main id="main" class="demo-page">
        <header class="page-banner">
          <p class="eyebrow">No mockups here.</p>
          <h1>Live behavior lab</h1>
          <p>Use a mouse, keyboard, or screen reader. Each example below runs the same package code your site would import.</p>
        </header>

        <div class="demo-grid">
          <PortalPanel title="Progressive tabs">
            <p>These links still navigate to visible sections before JavaScript upgrades them.</p>
            <manner-tabs class="demo-tabs">
              <nav data-tablist aria-label="Project phases">
                <a data-tab href="#plan">Plan</a>
                <a data-tab href="#build">Build</a>
                <a data-tab href="#verify">Verify</a>
              </nav>
              <section id="plan" data-panel><h2>Plan in HTML</h2><p>Start with meaningful links and sections.</p></section>
              <section id="build" data-panel><h2>Add behavior</h2><p>Import MannerHTML and keep authoring your own markup.</p></section>
              <section id="verify" data-panel><h2>Test the result</h2><p>Exercise real focus, exposed roles, and the no-JS fallback.</p></section>
            </manner-tabs>
            <a class="arrow-link" href={`${base}components/tabs/`}>Read the tabs contract</a>
          </PortalPanel>

          <PortalPanel title="Manual application tabs">
            <p>Arrow keys move focus; Enter or Space changes the selected panel.</p>
            <manner-tabs class="demo-tabs" data-activation="manual">
              <div data-tablist aria-label="Settings sections">
                <button data-tab type="button">Profile</button>
                <button data-tab type="button">Privacy</button>
                <button data-tab type="button">Alerts</button>
              </div>
              <section data-panel><h2>Profile</h2><p>Your public name and profile details.</p></section>
              <section data-panel><h2>Privacy</h2><p>Controls for visibility and data sharing.</p></section>
              <section data-panel><h2>Alerts</h2><p>Choose which notifications reach you.</p></section>
            </manner-tabs>
          </PortalPanel>

          <PortalPanel title="Native form validation" class="form-demo-panel">
            <p>The summary and field message are authored here. MannerHTML coordinates visibility, ARIA, and focus.</p>
            <manner-form>
              <form data-demo-form>
                <div class="error-summary" data-error-summary aria-live="polite" tabindex="-1" hidden>
                  <strong>Please fix this problem:</strong>
                  <ul><li data-summary-for="demo-email" hidden><a href="#demo-email">Enter a valid email address.</a></li></ul>
                </div>
                <label for="demo-email">Work email</label>
                <input id="demo-email" name="email" type="email" autocomplete="email" required />
                <p class="field-error" id="demo-email-error" data-error-for="demo-email" hidden>Enter a valid email address.</p>
                <button class="submit-button" type="submit">Validate email</button>
                <p class="success-message" role="status" hidden>Looks good. The demo stopped before sending anything.</p>
              </form>
            </manner-form>
            <a class="arrow-link" href={`${base}components/forms/`}>Read the form contract</a>
          </PortalPanel>
        </div>
      </main>
      <PortalFooter />
    </div>
    <script is:inline type="module" src={library}></script>
    <script is:inline>
      document.querySelectorAll("[data-demo-form]").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (!form.checkValidity()) return;
          event.preventDefault();
          form.querySelector(".success-message").hidden = false;
        });
      });
    </script>
  </body>
</html>
