---
import PortalFooter from "../components/PortalFooter.astro";
import PortalHeader from "../components/PortalHeader.astro";
import "../styles/portal.css";

const base = import.meta.env.BASE_URL;
const library = `${base}dist/index.js`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Try MannerHTML tabs and form validation in live, keyboard-operable demos." />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>Live demos — MannerHTML</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="portal-shell">
      <PortalHeader />
      <main id="main" class="demo-page">
        <header class="page-banner">
          <p class="eyebrow">No mockups here</p>
          <h1>Live behavior lab</h1>
          <p>Use a mouse, keyboard, or screen reader. Each example below runs the same package code your site would import.</p>
        </header>

        <div class="demo-grid">
          <section class="demo-panel">
            <h2>Progressive tabs</h2>
            <p>These links still navigate to visible sections before JavaScript upgrades them.</p>
            <manner-tabs class="demo-tabs">
              <nav data-tablist aria-label="Project phases">
                <a data-tab href="#plan">Plan</a>
                <a data-tab href="#build">Build</a>
                <a data-tab href="#verify">Verify</a>
              </nav>
              <section id="plan" data-panel><h2>Plan in HTML</h2><p>Start with meaningful links and sections.</p></section>
              <section id="build" data-panel><h2>Add behavior</h2><p>Import MannerHTML and keep authoring your own markup.</p></section>
              <section id="verify" data-panel><h2>Test the result</h2><p>Exercise real focus, exposed roles, and the no-JS fallback.</p></section>
            </manner-tabs>
            <p class="keyboard-hint"><a class="arrow-link" href={`${base}components/tabs/`}>Read the tabs contract</a></p>
          </section>

          <section class="demo-panel">
            <h2>Manual application tabs</h2>
            <p>Arrow keys move focus; Enter or Space changes the selected panel.</p>
            <manner-tabs class="demo-tabs" data-activation="manual">
              <div data-tablist aria-label="Settings sections">
                <button data-tab type="button">Profile</button>
                <button data-tab type="button">Privacy</button>
                <button data-tab type="button">Alerts</button>
              </div>
              <section data-panel><h2>Profile</h2><p>Your public name and profile details.</p></section>
              <section data-panel><h2>Privacy</h2><p>Controls for visibility and data sharing.</p></section>
              <section data-panel><h2>Alerts</h2><p>Choose which notifications reach you.</p></section>
            </manner-tabs>
            <p class="keyboard-hint">Try ← → Home End</p>
          </section>

          <section class="demo-panel carousel-demo-panel">
            <h2>Manual item sequence</h2>
            <p>Previous and Next change the visible item while focus stays on the button. The finite boundary is intentional.</p>
            <manner-carousel class="demo-carousel" aria-label="Field notes">
              <div data-slides>
                <figure data-slide aria-label="River walk, spring"><div class="demo-slide-art" aria-hidden="true">01</div><figcaption>River walk, spring</figcaption></figure>
                <figure data-slide aria-label="Night market, summer" hidden><div class="demo-slide-art" aria-hidden="true">02</div><figcaption>Night market, summer</figcaption></figure>
                <figure data-slide aria-label="First snow, winter" hidden><div class="demo-slide-art" aria-hidden="true">03</div><figcaption>First snow, winter</figcaption></figure>
              </div>
              <div class="carousel-controls">
                <button type="button" data-previous>Previous</button>
                <button type="button" data-next>Next</button>
              </div>
            </manner-carousel>
            <p class="keyboard-hint"><a class="arrow-link" href={`${base}components/carousel/`}>Read the Carousel contract</a></p>
            <button id="demo-open-gallery" class="submit-button" type="button">Open in dialog</button>
          </section>

          <section class="demo-panel form-demo-panel">
            <h2>Native form validation</h2>
            <p>The summary and field message are authored here. MannerHTML coordinates visibility, ARIA, and focus.</p>
            <manner-form>
              <form data-demo-form>
                <div class="error-summary" data-error-summary aria-live="polite" tabindex="-1" hidden>
                  <strong>Please fix this problem:</strong>
                  <ul><li data-summary-for="demo-email" hidden><a href="#demo-email">Enter a valid email address.</a></li></ul>
                </div>
                <label for="demo-email">Work email</label>
                <input id="demo-email" name="email" type="email" autocomplete="email" required />
                <p class="field-error" id="demo-email-error" data-error-for="demo-email" hidden>Enter a valid email address.</p>
                <button class="submit-button" type="submit">Validate email</button>
                <p class="success-message" role="status" hidden>Looks good. The demo stopped before sending anything.</p>
              </form>
            </manner-form>
            <p class="keyboard-hint"><a class="arrow-link" href={`${base}components/forms/`}>Read the form contract</a></p>
          </section>
        </div>
      </main>
      <PortalFooter />
    </div>
    <dialog id="demo-gallery-dialog" class="demo-dialog">
      <manner-carousel aria-label="Dialog field notes" data-loop>
        <div data-slides>
          <figure data-slide aria-label="Dialog note one"><div class="demo-slide-art" aria-hidden="true">A</div><figcaption>Dialog note one</figcaption></figure>
          <figure data-slide aria-label="Dialog note two" hidden><div class="demo-slide-art" aria-hidden="true">B</div><figcaption>Dialog note two</figcaption></figure>
        </div>
        <div class="carousel-controls">
          <button type="button" data-previous>Previous</button>
          <button type="button" data-next>Next</button>
        </div>
      </manner-carousel>
      <form method="dialog"><button class="submit-button" type="submit">Close</button></form>
    </dialog>
    <script is:inline type="module" src={library}></script>
    <script is:inline>
      document.querySelectorAll("[data-demo-form]").forEach((form) => {
        form.addEventListener("submit", (event) => {
          if (!form.checkValidity()) return;
          event.preventDefault();
          form.querySelector(".success-message").hidden = false;
        });
      });
      const opener = document.querySelector("#demo-open-gallery");
      const gallery = document.querySelector("#demo-gallery-dialog");
      opener?.addEventListener("click", () => gallery?.showModal());
    </script>
  </body>
</html>
