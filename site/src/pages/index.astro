---
import heroWoman from "../assets/hero-woman.jpg";
import promoMan from "../assets/promo-man.jpg";
import PortalFooter from "../components/PortalFooter.astro";
import PortalHeader from "../components/PortalHeader.astro";
import "../styles/portal.css";

const base = import.meta.env.BASE_URL;
const library = `${base}dist/index.js`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="MannerHTML adds accessible interaction behavior to author-owned HTML without rendering components or shipping CSS." />
    <link rel="icon" href={`${base}favicon.svg`} />
    <title>MannerHTML — Accessible behavior for your HTML</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="portal-shell">
      <PortalHeader />
      <main id="main">
        <section class="hero" aria-labelledby="hero-title">
          <img class="hero-photo" src={heroWoman.src} width={heroWoman.width} height={heroWoman.height} alt="Woman in oversized sunglasses and a silver jacket against an electric-blue studio background" />
          <div class="halftone" aria-hidden="true"></div>
          <div class="hero-block">
            <div class="hero-copy">
              <p class="eyebrow">HTML, meet good manners</p>
              <h1 id="hero-title"><span>write the markup.</span><strong>keep the behavior.</strong></h1>
              <p class="hero-lede">MannerHTML adds the interaction HTML does not provide, without taking away your markup, your styles, or your framework.</p>
            </div>
            <aside class="hero-news" aria-label="Latest release">
              <p class="hero-news-version">v0.2.0</p>
              <p><strong>Out now:</strong> findable inactive panels, cleaner tab stops, and reset-safe form errors.</p>
              <a href="https://github.com/samanshaiza004/mannerhtml/releases/tag/v0.2.0">Read the release note ›</a>
            </aside>
          </div>
        </section>

        <div class="tab-row">
          <section class="tab-card">
            <h2>Start</h2>
            <p class="card-eyebrow">manner / new user</p>
            <img class="card-shot" src={heroWoman.src} alt="" />
            <p class="card-lead"><a href={`${base}docs/`}>Add behavior in one line</a></p>
            <p>Install the module, import it once, and the elements you already authored start behaving.</p>
            <ul class="card-links">
              <li><a href={`${base}docs/`}>Install the module</a></li>
              <li><a href={`${base}docs/`}>Quick start</a></li>
              <li><a href={`${base}demos/#carousel-demo`}>Run the carousel demo</a></li>
              <li><a href={`${base}reference/testing/`}>Browser support</a></li>
            </ul>
            <p class="card-foot">npm | ESM | TypeScript</p>
          </section>

          <section class="tab-card">
            <h2>Build</h2>
            <p class="card-eyebrow">author / markup</p>
            <div class="card-diagram" aria-hidden="true">
              <img src={heroWoman.src} alt="" />
              <p><span>HTML</span><b>→</b><span>MANNER</span><b>→</b><span>ARIA</span></p>
            </div>
            <p class="card-lead"><a href={`${base}components/tabs/`}>Describe meaning, not widgets</a></p>
            <p>You keep the elements and the classes. MannerHTML wires roles, keyboard, and focus around them.</p>
            <ul class="card-links">
              <li><a href={`${base}components/tabs/`}>Tabs contract</a></li>
              <li><a href={`${base}components/forms/`}>Form validation</a></li>
              <li><a href={`${base}components/carousel/`}>Carousel contract</a></li>
              <li><a href={`${base}reference/api/`}>Methods and events</a></li>
              <li><a href={`${base}guides/native-html-first/`}>Native HTML first</a></li>
            </ul>
            <p class="card-foot">three elements | no shadow DOM</p>
          </section>

          <section class="tab-card">
            <h2>Understand</h2>
            <p class="card-eyebrow">access / evidence</p>
            <img class="card-shot card-shot--alt" src={promoMan.src} alt="" />
            <p class="card-lead"><a href={`${base}guides/accessibility/`}>Accessible by construction</a></p>
            <p>Real focus moves, exposed roles, and a no-JavaScript fallback that still navigates.</p>
            <ul class="card-links">
              <li><a href={`${base}guides/accessibility/`}>Accessibility guide</a></li>
              <li><a href={`${base}reference/testing/`}>Testing evidence</a></li>
              <li><a href={`${base}guides/native-html-first/`}>When to skip the layer</a></li>
              <li><a href="https://github.com/samanshaiza004/mannerhtml/issues">Report a behavior bug</a></li>
            </ul>
            <p class="card-foot">117 tests | 3 engines</p>
          </section>
        </div>

        <section class="download-strip" aria-labelledby="download-title">
          <div class="download-main">
            <h2 id="download-title">Download</h2>
            <p class="card-eyebrow">latest / release</p>
            <div class="install-line">
              <code id="install-command">npm install mannerhtml</code>
              <button class="copy-button" type="button" data-copy-for="install-command" hidden>COPY</button>
            </div>
            <p>One package, three behaviors, no stylesheet. Types and source maps ship with the build.</p>
          </div>
          <div class="download-links">
            <ul class="card-links">
              <li><a href="https://www.npmjs.com/package/mannerhtml">Package on npm</a></li>
              <li><a href="https://github.com/samanshaiza004/mannerhtml/archive/refs/tags/v0.2.0.tar.gz">Source archive</a></li>
            </ul>
            <ul class="card-links">
              <li><a href="https://github.com/samanshaiza004/mannerhtml/releases/tag/v0.2.0">Release notes</a></li>
              <li><a href="https://github.com/samanshaiza004/mannerhtml/blob/main/LICENSE">MIT license</a></li>
            </ul>
          </div>
          <p class="card-foot">developer preview / small and deliberate surface</p>
        </section>

        <div class="feature-row">
          <section class="feature feature--blue">
            <p class="feature-tag">01 / why manner</p>
            <h2>You write the HTML.</h2>
            <p>No virtual DOM, no shadow DOM, no styling opinion. Just standards, keyboard support, and careful ARIA around the markup you already ship.</p>
            <a class="arrow-link" href={`${base}docs/`}>How enhancement works</a>
          </section>

          <section class="feature feature--navy">
            <p class="feature-tag">02 / native by default</p>
            <h2>Not every widget needs JS.</h2>
            <p>Details, dialog, popover, and select already carry behavior. MannerHTML is for the interactions HTML genuinely leaves to you.</p>
            <a class="arrow-link" href={`${base}guides/native-html-first/`}>See the decision table</a>
          </section>

          <section class="feature feature--sand">
            <p class="feature-tag">03 / small surface</p>
            <h2>Three behaviors on purpose.</h2>
            <p><code>manner-tabs</code>, <code>manner-form</code>, and <code>manner-carousel</code> are the whole library. Layout, theming, and structure stay deliberately unclaimed.</p>
            <a class="arrow-link" href={`${base}reference/api/`}>Read the API reference</a>
          </section>
        </div>

        <div class="promo-row">
          <aside class="promo" aria-labelledby="promo-title">
            <img src={promoMan.src} width={promoMan.width} height={promoMan.height} alt="Man in a royal-blue shirt against a bright yellow studio background" />
            <div class="promo-copy">
              <h2 id="promo-title">Start with the docs.</h2>
            <p>Install the package, try the live behavior lab, then read the guide for when native HTML is already the answer.</p>
              <a class="promo-button" href={`${base}docs/`}>OPEN GUIDE ›</a>
            </div>
          </aside>

          <section class="wire" aria-labelledby="wire-title">
            <h2 id="wire-title">Project wire</h2>
            <ol>
              <li>
                <span class="wire-badge wire-badge--now">NOW</span>
                <p>v0.2.0 hardens the details: findable inactive panels, cleaner tab stops, and observable invalid forms. <a href="https://github.com/samanshaiza004/mannerhtml/releases/tag/v0.2.0">Release note ›</a></p>
              </li>
              <li>
                <span class="wire-badge wire-badge--built">BUILT</span>
                <p>Tabs and form validation, both exercised in Chromium, Firefox, and WebKit. <a href={`${base}components/tabs/`}>Behaviors ›</a></p>
              </li>
              <li>
                <span class="wire-badge wire-badge--open">OPEN</span>
                <p>The manual screen-reader matrix is still in progress and is reported honestly. <a href={`${base}reference/testing/`}>Evidence ›</a></p>
              </li>
            </ol>
            <p class="card-foot">pre-1.0 / semantic versioning starts at the first stable release</p>
          </section>
        </div>

        <ul class="spec-strip">
          <li><b>Version:</b> 0.2.0</li>
          <li><b>Module:</b> ESM</li>
          <li><b>Types:</b> included</li>
          <li><b>Tests:</b> 117</li>
          <li><b>Engines:</b> 3</li>
          <li><b>License:</b> MIT</li>
        </ul>

        <div class="link-columns">
          <nav aria-labelledby="col-new">
            <h2 id="col-new"><b>New user</b> start here</h2>
            <ul>
              <li><a href={`${base}docs/`}>Installation</a></li>
              <li><a href={`${base}docs/`}>Quick start</a></li>
              <li><a href={`${base}demos/`}>Live demos</a></li>
              <li><a href={`${base}reference/testing/`}>Browser support</a></li>
            </ul>
          </nav>
          <nav aria-labelledby="col-dev">
            <h2 id="col-dev"><b>Developer</b> deeper in</h2>
            <ul>
              <li><a href={`${base}components/tabs/`}>Tabs contract</a></li>
              <li><a href={`${base}components/forms/`}>Forms contract</a></li>
              <li><a href={`${base}components/carousel/`}>Carousel contract</a></li>
              <li><a href={`${base}reference/api/`}>Methods and events</a></li>
              <li><a href={`${base}guides/accessibility/`}>Accessibility guide</a></li>
              <li><a href={`${base}guides/native-html-first/`}>Native HTML first</a></li>
              <li><a href={`${base}reference/testing/`}>Testing evidence</a></li>
            </ul>
          </nav>
        </div>
      </main>
      <PortalFooter />
    </div>
    <script is:inline type="module" src={library}></script>
    <script is:inline>
      document.querySelectorAll("[data-copy-for]").forEach((button) => {
        if (!navigator.clipboard) return;
        const source = document.getElementById(button.dataset.copyFor);
        if (!source) return;
        button.hidden = false;
        button.addEventListener("click", async () => {
          await navigator.clipboard.writeText(source.textContent.trim());
          button.textContent = "COPIED";
          setTimeout(() => { button.textContent = "COPY"; }, 1600);
        });
      });
    </script>
  </body>
</html>
