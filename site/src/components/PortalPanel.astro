---
interface Props {
  title: string;
  class?: string;
  moreHref?: string;
  moreLabel?: string;
}

const { title, class: className, moreHref, moreLabel = "more" } = Astro.props;
---

<section class:list={["portal-panel", className]}>
  <header class="panel-title">
    <h2>{title}</h2>
    {moreHref && <a href={moreHref}>» {moreLabel}</a>}
  </header>
  <div class="panel-body"><slot /></div>
</section>
