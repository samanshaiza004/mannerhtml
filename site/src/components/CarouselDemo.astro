---
const base = import.meta.env.BASE_URL;
---

<section class="carousel-demo" aria-labelledby="carousel-demo-title">
  <div class="demo-heading">
    <p class="demo-eyebrow">Live behavior / manual sequence</p>
    <h2 id="carousel-demo-title">One item. Two buttons. No surprises.</h2>
    <p>Activate a native button and watch the item change without losing focus. The first example stops at its boundaries; the second wraps with <code>data-loop</code>.</p>
  </div>

  <div class="demo-cards">
    <article class="demo-card">
      <p class="demo-label">Finite sequence</p>
      <manner-carousel aria-label="Seasonal field notes">
        <div data-slides>
          <figure data-slide aria-labelledby="field-note-spring">
            <div class="slide-art slide-art--spring" aria-hidden="true"><span>01</span><small>SPRING</small></div>
            <figcaption id="field-note-spring">River walk <span>March 2026</span></figcaption>
          </figure>
          <figure data-slide aria-labelledby="field-note-summer" hidden>
            <div class="slide-art slide-art--summer" aria-hidden="true"><span>02</span><small>SUMMER</small></div>
            <figcaption id="field-note-summer">Night market <span>July 2026</span></figcaption>
          </figure>
          <figure data-slide aria-labelledby="field-note-winter" hidden>
            <div class="slide-art slide-art--winter" aria-hidden="true"><span>03</span><small>WINTER</small></div>
            <figcaption id="field-note-winter">First snow <span>December 2026</span></figcaption>
          </figure>
        </div>
        <div class="demo-controls">
          <button type="button" data-previous>Previous</button>
          <span data-position>Slide 1 of 3</span>
          <button type="button" data-next>Next</button>
        </div>
      </manner-carousel>
      <p class="demo-note">At the first and last slides, the corresponding button stays focusable and exposes <code>aria-disabled="true"</code>.</p>
    </article>

    <article class="demo-card">
      <p class="demo-label">Looping sequence</p>
      <manner-carousel aria-label="Color studies" data-loop>
        <div data-slides>
          <figure data-slide aria-label="Blue study">
            <div class="slide-art slide-art--blue" aria-hidden="true"><span>A</span><small>BLUE</small></div>
            <figcaption>Blue study <span>Looping example</span></figcaption>
          </figure>
          <figure data-slide aria-label="Yellow study" hidden>
            <div class="slide-art slide-art--yellow" aria-hidden="true"><span>B</span><small>YELLOW</small></div>
            <figcaption>Yellow study <span>Looping example</span></figcaption>
          </figure>
          <figure data-slide aria-label="Red study" hidden>
            <div class="slide-art slide-art--red" aria-hidden="true"><span>C</span><small>RED</small></div>
            <figcaption>Red study <span>Looping example</span></figcaption>
          </figure>
        </div>
        <div class="demo-controls">
          <button type="button" data-previous>Previous</button>
          <span data-position>Slide 1 of 3</span>
          <button type="button" data-next>Next</button>
        </div>
      </manner-carousel>
      <p class="demo-note">With <code>data-loop</code>, both controls remain available and wrap around the sequence.</p>
    </article>
  </div>

  <p class="demo-footnote">This page imports the package itself. The announcement surface is the author-owned <code>[data-slides]</code> wrapper; focus remains on the button you activated.</p>
</section>

<script is:inline type="module" src={`${base}dist/index.js`}></script>
<script is:inline>
  document.querySelectorAll(".carousel-demo manner-carousel").forEach((carousel) => {
    const position = carousel.querySelector("[data-position]");
    const slides = carousel.querySelectorAll("[data-slide]");
    const updatePosition = () => {
      if (position) position.textContent = `Slide ${carousel.selectedIndex + 1} of ${slides.length}`;
    };
    carousel.addEventListener("manner-carousel-change", updatePosition);
    updatePosition();
  });
</script>

<style>
  .carousel-demo {
    margin: 1.75rem 0 2.5rem;
    border: 2px solid #001c9b;
    background: linear-gradient(135deg, #f4f7ff, #fff);
    box-shadow: 5px 5px 0 rgb(7 56 238 / 15%);
  }

  .demo-heading {
    padding: 1rem 1.1rem;
    color: #fff;
    background: linear-gradient(105deg, #00136f, #0738ee);
  }

  .demo-eyebrow,
  .demo-label {
    margin: 0;
    color: #ffd200;
    font-size: 0.73rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .demo-heading h2 {
    margin: 0.25rem 0 0;
    padding: 0;
    border: 0;
    color: #fff;
    font-family: "Arial Black", Arial, sans-serif;
    font-size: clamp(1.25rem, 4vw, 1.75rem);
  }

  .demo-heading p:last-child {
    max-width: 42rem;
    margin: 0.5rem 0 0;
    color: #eef3ff;
  }

  .demo-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0.8rem;
  }

  .demo-card {
    padding: 0.8rem;
    border: 1px solid #aeb7c9;
    background: #fff;
  }

  .demo-card manner-carousel {
    display: block;
    margin-top: 0.55rem;
  }

  .demo-card [data-slides] {
    min-height: 10.5rem;
    padding: 0.55rem;
    border: 1px solid #aeb7c9;
    background: #f7f9ff;
  }

  .demo-card figure {
    margin: 0;
  }

  .slide-art {
    display: flex;
    min-height: 7rem;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0.7rem;
    color: #fff;
  }

  .slide-art span {
    font: 900 3rem/0.8 "Arial Black", Arial, sans-serif;
  }

  .slide-art small {
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .slide-art--spring { background: linear-gradient(135deg, #237a57, #b2d235); }
  .slide-art--summer { background: linear-gradient(135deg, #ef7d22, #7d1d6c); }
  .slide-art--winter { background: linear-gradient(135deg, #0738ee, #9ddbf5); }
  .slide-art--blue { background: linear-gradient(135deg, #00136f, #4b7dff); }
  .slide-art--yellow { background: linear-gradient(135deg, #ffd200, #ef7d22); }
  .slide-art--red { background: linear-gradient(135deg, #b00020, #ff6b4a); }

  .demo-card figcaption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.45rem;
    color: #00136f;
    font-weight: 800;
  }

  .demo-card figcaption span {
    color: #59647c;
    font-size: 0.8em;
    font-weight: 600;
  }

  .demo-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem;
    margin-top: 0.55rem;
  }

  .demo-controls button {
    border: 1px solid #00136f;
    padding: 0.38rem 0.6rem;
    color: #fff;
    background: #0738ee;
    font: 700 0.82rem Arial, sans-serif;
    cursor: pointer;
  }

  .demo-controls button:hover,
  .demo-controls button:focus-visible {
    background: #00136f;
  }

  .demo-controls button[aria-disabled="true"] {
    color: #59647c;
    background: #e1e5ee;
  }

  .demo-controls span {
    color: #59647c;
    font: 700 0.75rem/1.2 "SFMono-Regular", Consolas, monospace;
    text-align: center;
  }

  .demo-note,
  .demo-footnote {
    margin: 0.65rem 0 0;
    color: #59647c;
    font-size: 0.86rem;
  }

  .demo-footnote {
    padding: 0 0.8rem 0.8rem;
  }

  @media (max-width: 42rem) {
    .demo-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
