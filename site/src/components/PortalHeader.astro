---
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname.endsWith("/demos/") ? "demos" : "home";
const explore = [
  { id: "docs", label: "Docs", href: `${base}docs/` },
  { id: "tabs", label: "Tabs", href: `${base}components/tabs/` },
  { id: "forms", label: "Forms", href: `${base}components/forms/` },
  { id: "carousel", label: "Carousel", href: `${base}components/carousel/` },
  { id: "demos", label: "Demos", href: `${base}demos/` },
  { id: "testing", label: "Testing", href: `${base}reference/testing/` },
  { id: "github", label: "Source", href: "https://github.com/samanshaiza004/mannerhtml" },
] as const;
---

<header class="site-header">
  <div class="masthead">
    <a class="wordmark" href={base}>
      <strong>MannerHTML</strong><span class="spark" aria-hidden="true">✦</span>
    </a>
    <form class="site-search" action={`${base}docs/`} role="search">
      <label for="site-query">Search:</label>
      <input id="site-query" name="q" type="search" />
      <button type="submit">GO</button>
    </form>
    <p class="masthead-links">
      <a href="https://github.com/samanshaiza004/mannerhtml/releases">Releases</a>
      <a href="https://github.com/samanshaiza004/mannerhtml/issues">Issues</a>
      <b>v0.2.0</b>
    </p>
    <span class="masthead-cut" aria-hidden="true"></span>
  </div>
  <nav class="portal-nav" aria-label="Primary">
    <a class="nav-home" href={base} aria-current={current === "home" ? "page" : undefined}>Home</a>
    <span class="nav-label" aria-hidden="true">Explore:</span>
    {explore.map((item) => (
      <a href={item.href} aria-current={current === item.id ? "page" : undefined}>{item.label}</a>
    ))}
  </nav>
</header>
