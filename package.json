{
  "name": "mannerhtml",
  "version": "0.1.0",
  "description": "Accessible, framework-independent behavior for author-owned HTML.",
  "license": "MIT",
  "author": "samanshaiza004",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./form": {
      "types": "./dist/form.d.ts",
      "import": "./dist/form.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "site:build": "node site/build.mjs",
    "site:dev": "npm run site:build && node site/server.mjs",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run test:browser && npm pack --dry-run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TESTING.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/samanshaiza004/mannerhtml.git"
  },
  "homepage": "https://samanshaiza004.github.io/mannerhtml/",
  "bugs": {
    "url": "https://github.com/samanshaiza004/mannerhtml/issues"
  }
}
