{
  "name": "manner",
  "version": "0.1.0",
  "description": "A small, framework-independent behavior layer for server-rendered HTML.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
