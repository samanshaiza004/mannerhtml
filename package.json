{
  "name": "manner",
  "version": "0.1.0",
  "description": "A small, framework-independent behavior layer for server-rendered HTML.",
  "license": "MIT",
  "author": "samanshaiza004",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test tests/*.test.js",
    "test:browser": "npm run build && playwright test",
    "test": "npm run test:unit && npm run test:browser",
    "prepublishOnly": "npm run typecheck && npm run test:unit && npm run test:browser && npm pack --dry-run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TESTING.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/samanshaiza004/manner.git"
  },
  "homepage": "https://github.com/samanshaiza004/manner#readme",
  "bugs": {
    "url": "https://github.com/samanshaiza004/manner/issues"
  }
}
